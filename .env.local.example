# ─────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────

# Supabase — Project Settings ▸ API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
# Used only inside Server Actions / server components for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL (used for SEO metadata, Open Graph, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS (public keys — safe in the browser) for the contact form
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=2QXkxh4_dNyK3ziI6
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_tab08ma
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_0okpl9v
